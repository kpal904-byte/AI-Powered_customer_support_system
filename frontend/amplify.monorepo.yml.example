# Copy this file to amplify.yml in the ROOT of your full repository
# when frontend/ and src/ (FastAPI backend) are in the same Git repository.
version: 1
applications:
  - appRoot: frontend
    frontend:
      phases:
        preBuild:
          commands:
            - npm install
        build:
          commands:
            - npm run build
      artifacts:
        baseDirectory: dist
        files:
          - '**/*'
      cache:
        paths:
          - node_modules/**/*
